#!/usr/bin/env bash
# Blocks a push whose new commits add a key, password or token anywhere in
# their history, not only at the tip (.githooks/secret-scan.sh).
# stdin: <local ref> <local sha> <remote ref> <remote sha>
zero=0000000000000000000000000000000000000000
scan="$(git rev-parse --show-toplevel)/.githooks/secret-scan.sh"
status=0
while read -r _lref lsha _rref rsha; do
  [[ "$lsha" == "$zero" ]] && continue                    # deleting a remote ref
  if [[ "$rsha" == "$zero" ]]; then
    "$scan" --range "$lsha" --not --remotes || status=1   # new branch: commits no remote has yet
  else
    "$scan" --range "$rsha..$lsha" || status=1
  fi
done
exit $status
